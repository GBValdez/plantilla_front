{
  "name": "panelbase",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "check:components": "ngc --project tsconfig.components.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "demo": "node tools/run-demo.mjs",
    "test:demo-api": "node --test tools/demo-api.test.mjs",
    "test:demo-ui": "playwright test --config playwright.demo.config.ts"
  },
  "private": true,
